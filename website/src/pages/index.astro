---
import Layout from '../layouts/Layout.astro';
import {
  loadReadmeCatalog,
  resolveCatalogUrl,
  withBase,
} from '../lib/catalog.mjs';
import { loadPrompts } from '../lib/prompts.mjs';

const base = import.meta.env.BASE_URL;
const catalog = loadReadmeCatalog();
const promptData = loadPrompts();
const resourceTotal = catalog.total;
const categoryTotal = catalog.categories.length;
const promptTotal = promptData.prompts.length;
const promptsHref = withBase(base, '/prompts/');

const CONTRIBUTORS = [
  { login: 'staruhub', name: 'staruhub', role: '仓库维护者' },
  { login: 'Tencent', name: 'Tencent', role: '官方评测基准' },
  { login: 'TencentEdgeOne', name: 'TencentEdgeOne', role: '建站 Prompt 池' },
  { login: 'shuangying0001-beep', name: 'shuangying0001', role: '22 个实战 Skills' },
  { login: 'Ldxs001', name: 'Ldxs001', role: '20+ 自研技能' },
  { login: 'cnproduct', name: 'cnproduct', role: '公众号发布技能' },
  { login: 'pipixia-run', name: 'pipixia-run', role: 'Agent 行为铁律' },
  { login: 'AlephAITech', name: 'AlephAITech', role: '实战蓝皮书' },
  { login: 'gtskevin', name: 'gtskevin', role: '问卷量表 Skill' },
  { login: 'reallysix', name: 'reallysix', role: '五事七计决策' },
  { login: 'VoltAgent', name: 'VoltAgent', role: '相关清单' },
  { login: 'hesreallyhim', name: 'hesreallyhim', role: '相关清单' },
  { login: 'punkpeye', name: 'punkpeye', role: 'MCP Server 大全' },
];

const FAQS = [
  { q: 'WorkBuddy 是什么？免费吗？', a: 'WorkBuddy 是腾讯出品的桌面 AI 办公智能体：说出要求，它自主规划、调用工具、生成文件，过程与结果都留给你审核。免费开始，新用户注册即送 Credits，发帖等社区活动还可额外领取。' },
  { q: 'WorkBuddy 和 CodeBuddy 有什么区别？', a: 'CodeBuddy 面向开发者，聚焦写代码；WorkBuddy 面向所有职场人，覆盖调研、报表、PPT、纪要等全场景办公。两者同属腾讯「Buddy 家族」，可以配合使用。' },
  { q: 'OpenClaw 的技能能直接用吗？', a: '可以。WorkBuddy 兼容 OpenClaw 的 Skill 格式，ClawHub 上数千个技能可检索安装；Claude Code 生态的 Skill 也大量互通，本清单的「相关列表」板块有入口。' },
  { q: '怎么安装一个 Skill？', a: '两条路：在应用内技能市场直接搜索安装；或下载 SKILL.md / ZIP 后放入技能目录。不会命令行也没关系，清单里多个仓库附有手把手的 WorkBuddy 安装指南。' },
  { q: '支持哪些系统和平台？', a: '客户端支持 Windows 与 macOS，官网自动识别系统。还可接入微信、企业微信、飞书、钉钉，海外版支持 Slack / Telegram / Discord，手机发指令电脑干活。' },
  { q: '如何向这份清单提交资源？', a: '在 GitHub 仓库发起 PR：附上链接、一句话描述和所属分类即可。先读 CONTRIBUTING.md；只要资源确实有用，自荐也欢迎。清单以 CC0 发布，可自由转载。' },
];

// Build-time view models from the two canonical repository sources.
const groups = catalog.categories.map((c, idx) => ({
  key: c.key,
  en: c.en,
  zh: c.zh,
  count: c.items.length,
  num: String(idx + 1).padStart(2, '0'),
  items: c.items.map((item) => ({
    ...item,
    ...resolveCatalogUrl(item.url, base),
  })),
}));

const promptsList = promptData.prompts.slice(0, 6).map((prompt) => ({
  ...prompt,
  num: String(prompt.id).padStart(2, '0'),
}));

// Pre-compute contributors
const contributors = CONTRIBUTORS.map(c => ({
  name: c.name,
  role: c.role,
  url: 'https://github.com/' + c.login,
  avatar: 'https://github.com/' + c.login + '.png?size=120',
}));

// Chip definitions for the filter bar
const chipDefs = [
  { key: 'all', label: '全部' },
  ...catalog.categories.map((category) => ({
    key: category.key,
    label: category.zh,
  })),
];
---

<Layout>
  <style is:inline>
    html, body { margin:0; padding:0; background:var(--bgpage); }
    * { box-sizing:border-box; }
    ::selection { background:#12B981; color:#fff; }
    a { color:var(--ink); text-decoration:none; }
    a:hover { color:#12B981; }
    @keyframes wbfloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-10px); } }
    [data-wb-vars] { --bgpage:#FFFFFF; --bgsoft:#F5F8F7; --card:#FFFFFF; --cardhover:#FBFEFD; --headbg:rgba(255,255,255,0.88); --ink:#0B0F0E; --t1b:#3B4644; --t2:#5C6664; --t3:#6B7573; --t4:#7A8582; --t5:#8A9491; --t6:#9AA4A1; --line:#E5EAE8; --line2:#F0F3F2; --ghost:#E9EDEB; }
    [data-wb-theme="dark"] { --bgpage:#0F1514; --bgsoft:#121917; --card:#151D1B; --cardhover:#1A2523; --headbg:rgba(15,21,20,0.85); --ink:#F0F4F3; --t1b:#CBD5D1; --t2:#A9B5B1; --t3:#97A39F; --t4:#8A9692; --t5:#75817D; --t6:#616D69; --line:#242E2B; --line2:#1D2724; --ghost:#182220; }
    [data-wb-theme="dark"] #wb-logo { filter:brightness(0) invert(1); }
    [data-wb-theme="dark"] [data-inkbtn] { background:#12B981 !important; }
    @media (max-width:900px) {
      [data-wrap] { padding-left:20px !important; padding-right:20px !important; }
      #wb-nav, #wb-count { display:none !important; }
      #wb-h1 { font-size:46px !important; }
      #wb-hero { padding-top:64px !important; padding-bottom:56px !important; }
      #wb-mascot { width:132px !important; left:4px !important; }
      #wb-stats { margin-top:44px !important; }
      #wb-stats > div { padding:18px 8px !important; }
      #wb-stats > div > div:first-child { font-size:28px !important; }
      #wb-stats > div > div:last-child { font-size:11.5px !important; }
      [data-h2] { font-size:30px !important; }
      [data-split] { grid-template-columns:1fr !important; gap:36px !important; }
      [data-pad] { padding-top:56px !important; padding-bottom:60px !important; }
      #wb-hero-copy { font-size:15.5px !important; }
    }
    @media (max-width:560px) {
      #wb-h1 { font-size:34px !important; }
      #wb-mascot { display:none !important; }
      [data-cta] { width:100% !important; justify-content:center !important; }
    }
  </style>

  <div data-wb-vars="1" data-wb-theme="light" id="wb-root" style="font-family:'Noto Sans SC','Archivo',system-ui,sans-serif; color:var(--ink); background:var(--bgpage); overflow-x:hidden; transition:background .3s ease, color .3s ease;">

    <!-- HEADER -->
    <header style="position:sticky; top:0; z-index:50; background:var(--headbg); backdrop-filter:blur(14px); border-bottom:1px solid var(--line);">
      <div data-wrap="1" style="max-width:1240px; margin:0 auto; padding:0 32px; height:68px; display:flex; align-items:center; gap:32px;">
        <a href="https://github.com/staruhub/awesome-workbuddy" style="display:flex; align-items:center;">
          <img id="wb-logo" src={`${base}/uploads/workbuddy-logo.png`} alt="WorkBuddy" style="height:30px; width:auto; display:block;" />
        </a>
        <nav id="wb-nav" style="display:flex; align-items:center; gap:26px; margin-left:8px; font-size:14px; font-weight:500;">
          <a href="https://www.workbuddy.cn/docs/workbuddy/Changelog" target="_blank" rel="noopener noreferrer" style="color:#12B981; font-weight:600;">最近更新</a>
          <a href="#resources" style="color:var(--t2);">资源清单</a>
          <a href={promptsHref} style="color:var(--t2);">Prompts</a>
          <a href="https://www.workbuddy.cn/" style="color:var(--t2);">WorkBuddy 官网</a>
        </nav>
        <div style="flex:1;"></div>
        <span id="wb-count" style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t5);">CC0 · {resourceTotal} resources</span>
        <button id="theme-toggle" title="切换深浅色" style="width:38px; height:38px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); cursor:pointer; font-size:15px; line-height:1; display:flex; align-items:center; justify-content:center;">&#9790;</button>
        <a href="https://github.com/staruhub/awesome-workbuddy" data-inkbtn="1" style="display:inline-flex; align-items:center; gap:8px; background:#0B0F0E; color:#fff; font-size:14px; font-weight:700; padding:11px 22px; border-radius:999px;">Star on GitHub</a>
      </div>
    </header>

    <!-- HERO -->
    <section style="position:relative; overflow:hidden; background:linear-gradient(180deg,var(--bgpage) 0%,var(--bgsoft) 100%); border-bottom:1px solid var(--line);">
      <div style="position:absolute; left:-4%; top:34%; transform:rotate(-24deg); font-family:'Archivo',sans-serif; font-weight:900; font-size:170px; line-height:0.82; color:var(--ghost); letter-spacing:-0.05em; pointer-events:none; user-select:none;">WORK<br/>BUDD&gt;_</div>
      <div style="position:absolute; right:-140px; top:-120px; width:520px; height:520px; border-radius:50%; background:radial-gradient(circle,rgba(18,185,129,0.16),rgba(18,185,129,0) 68%); pointer-events:none;"></div>
      <div style="position:absolute; left:-10%; top:18%; width:120%; height:1px; background:linear-gradient(90deg,rgba(11,15,14,0),rgba(11,15,14,0.09),rgba(11,15,14,0)); transform:rotate(-14deg); pointer-events:none;"></div>
      <div style="position:absolute; left:-10%; top:58%; width:120%; height:1px; background:linear-gradient(90deg,rgba(11,15,14,0),rgba(11,15,14,0.07),rgba(11,15,14,0)); transform:rotate(-14deg); pointer-events:none;"></div>
      <div style="position:absolute; right:16%; top:24%; width:26px; height:26px; background:#12B981; transform:skewY(-14deg); pointer-events:none; box-shadow:0 14px 30px -10px rgba(18,185,129,0.6);"></div>
      <div style="position:absolute; right:13.5%; top:31%; width:12px; height:12px; background:#0B0F0E; transform:skewY(-14deg); pointer-events:none; opacity:0.12;"></div>

      <div data-wrap="1" id="wb-hero" style="position:relative; max-width:1240px; margin:0 auto; padding:104px 32px 76px; text-align:center;">
        <div style="display:inline-flex; align-items:center; gap:10px; background:var(--card); border:1px solid var(--line); border-radius:999px; padding:7px 16px; font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t1b); margin-bottom:34px;">
          <span style="width:7px; height:7px; border-radius:50%; background:#12B981; display:block;"></span>
          Open Source · CC0 License · 社区共建
        </div>

        <h1 id="wb-h1" style="margin:0; font-family:'Archivo','Noto Sans SC',sans-serif; font-weight:900; font-size:86px; line-height:0.94; letter-spacing:-0.045em; text-wrap:balance;">
          AWESOME<br/><span style="display:inline-flex; align-items:baseline;">WORKBUDD<span style="color:#12B981;">&gt;_</span></span>
        </h1>

        <p id="wb-hero-copy" style="max-width:660px; margin:30px auto 0; font-size:17px; line-height:1.85; color:var(--t2); text-wrap:pretty;">
          腾讯 WorkBuddy 生态资源精选清单。官方资源、技能插件、提示词工作流、教程、评测与对比，一站式收录，持续更新。
        </p>

        <div style="display:flex; justify-content:center; gap:14px; margin-top:38px; flex-wrap:wrap;">
          <a href="https://github.com/staruhub/awesome-workbuddy" style="display:inline-flex; align-items:center; gap:10px; background:#12B981; color:#fff; font-size:15px; font-weight:700; padding:15px 30px; border-radius:12px; box-shadow:0 10px 24px -12px rgba(18,185,129,0.9);" data-cta="1">★ Star on GitHub</a>
          <a href="https://www.workbuddy.cn/" style="display:inline-flex; align-items:center; gap:10px; background:var(--card); color:var(--ink); border:1px solid var(--line); font-size:15px; font-weight:700; padding:15px 30px; border-radius:12px;" data-cta="1">访问 WorkBuddy 官网 ↗</a>
        </div>

        <div id="wb-stats" data-reveal="1" style="display:flex; justify-content:center; gap:0; margin-top:64px; border:1px solid var(--line); background:var(--card); border-radius:18px; overflow:hidden; max-width:720px; margin-left:auto; margin-right:auto;">
          <div style="flex:1; padding:26px 20px; border-right:1px solid var(--line);">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:38px; letter-spacing:-0.03em;">{resourceTotal}</div>
            <div style="font-size:13px; color:var(--t4); margin-top:4px;">个精选资源</div>
          </div>
          <div style="flex:1; padding:26px 20px; border-right:1px solid var(--line);">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:38px; letter-spacing:-0.03em;">{categoryTotal}</div>
            <div style="font-size:13px; color:var(--t4); margin-top:4px;">个分类</div>
          </div>
          <div style="flex:1; padding:26px 20px;">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:38px; letter-spacing:-0.03em; color:#12B981;">{promptTotal}</div>
            <div style="font-size:13px; color:var(--t4); margin-top:4px;">条提效 Prompts</div>
          </div>
        </div>
      </div>
      <img src="https://codebuddy-1328495429.cos.accelerate.myqcloud.com/web/workbuddy/70987efec023ba6c4d65744aafb9fb7c67629a48/assets/scenario1-feature1-BPMObM4f.png" alt="" id="wb-mascot" style="position:absolute; left:24px; bottom:0; width:190px; height:auto; pointer-events:none; user-select:none;" />
    </section>

    <!-- RECENT UPDATES -->
    <section data-reveal="1" style="background:var(--bgsoft); border-bottom:1px solid var(--line);">
      <div data-wrap="1" style="max-width:1240px; margin:0 auto; padding:56px 32px 60px;">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:28px;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.08em; color:#12B981;">RECENT UPDATES</span>
          <span style="flex:1; height:1px; background:var(--line2);"></span>
          <a href="https://www.workbuddy.cn/docs/workbuddy/Changelog" target="_blank" rel="noopener noreferrer" style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t5);">完整更新日志 ↗</a>
        </div>
        <h2 style="margin:0 0 24px 0; font-family:'Archivo','Noto Sans SC',sans-serif; font-weight:900; font-size:clamp(26px,5.4vw,36px); letter-spacing:-0.03em;">WorkBuddy 最近更新</h2>
        <div style="display:grid; gap:14px;">
          <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:20px 22px;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
              <span style="font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:700; color:#12B981;">5.3.12</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:11.5px; color:var(--t6);">2026-08-12</span>
              <span style="display:inline-flex; align-items:center; gap:5px; background:rgba(18,185,129,0.1); color:#12B981; font-size:11px; font-weight:700; padding:3px 9px; border-radius:999px;">最新</span>
            </div>
            <ul style="margin:0; padding-left:20px; font-size:14px; line-height:1.85; color:var(--t2);">
              <li>灵感分享口令</li>
              <li>弱网/休眠后续聊更稳</li>
              <li>修复：大 Markdown 卡死、中文路径 Access denied、白屏、本地助理内存、锁屏远程状态丢失等</li>
            </ul>
          </div>
          <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:20px 22px;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
              <span style="font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:700; color:var(--t1b);">5.3.11</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:11.5px; color:var(--t6);">2026-08-07</span>
            </div>
            <ul style="margin:0; padding-left:20px; font-size:14px; line-height:1.85; color:var(--t2);">
              <li>企微/微信助理逐字流式；可先发文件再补文字</li>
              <li>对话显示每轮耗时；任务批量删除/归档</li>
              <li>「我安装的」技能本地搜索；开机自启；改昵称</li>
              <li>Python 类连接器运行时</li>
            </ul>
          </div>
          <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:20px 22px;">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
              <span style="font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:700; color:var(--t1b);">5.3.3</span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:11.5px; color:var(--t6);">2026-07-21</span>
              <span style="display:inline-flex; align-items:center; gap:5px; background:var(--bgsoft); border:1px solid var(--line); color:var(--t4); font-size:11px; font-weight:700; padding:3px 9px; border-radius:999px;">功能大版本</span>
            </div>
            <ul style="margin:0; padding-left:20px; font-size:14px; line-height:1.85; color:var(--t2);">
              <li>项目计划重构；企业智能体</li>
              <li>腾讯文档深集成；PPT 内置插件</li>
              <li>Ardot 画布预览；本地长期记忆可编辑</li>
              <li>快捷键云同步；意图胶囊推荐 Skill/Plugin/Connector</li>
              <li>安全中心文件修改自动备份</li>
            </ul>
          </div>
          <div style="padding:16px 22px; font-size:13px; color:var(--t5); text-align:center;">
            5.3.8–5.3.5 多为稳定性/性能修复 + Buddy AI 国内升配 ·
            <a href="https://www.workbuddy.cn/docs/workbuddy/Changelog" target="_blank" rel="noopener noreferrer" style="color:#12B981; font-weight:600;">查看完整历史</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CATEGORY FILTER BAR -->
    <div id="resources" style="position:sticky; top:68px; z-index:40; background:var(--headbg); backdrop-filter:blur(14px); border-bottom:1px solid var(--line);">
      <div data-wrap="1" style="max-width:1240px; margin:0 auto; padding:14px 32px; display:flex; gap:8px; flex-wrap:wrap; overflow-x:auto;">
        {chipDefs.map(chip => (
          <button data-filter={chip.key} class="wb-chip" style={`border:1px solid ${chip.key === 'all' ? '#12B981' : 'var(--line)'}; background:${chip.key === 'all' ? '#12B981' : 'var(--card)'}; color:${chip.key === 'all' ? '#fff' : 'var(--t2)'}; font-family:'Noto Sans SC',sans-serif; font-size:13.5px; font-weight:700; padding:9px 16px; border-radius:999px; cursor:pointer; transition:all .15s;`}>{chip.label}</button>
        ))}
      </div>
    </div>

    <!-- MAIN RESOURCE DIRECTORY -->
    <main data-wrap="1" data-pad="1" style="max-width:1240px; margin:0 auto; padding:56px 32px 90px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:40px;">
        <span style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.08em; color:#12B981;">RESOURCE DIRECTORY</span>
        <span style="flex:1; height:1px; background:var(--line2);"></span>
        <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t6);">curated &amp; verified by hand</span>
      </div>
      {groups.map(g => (
        <section data-reveal="1" data-cat={g.key} class="wb-group" style="margin-bottom:64px;">
          <div style="display:flex; align-items:baseline; gap:14px; margin-bottom:6px;">
            <span style="font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:700; color:#12B981;">{g.num}</span>
            <h2 style="margin:0; font-family:'Archivo','Noto Sans SC',sans-serif; font-weight:900; font-size:clamp(22px,5.4vw,30px); letter-spacing:-0.03em;">{g.en}</h2>
            <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--t6);">({g.count})</span>
            <span style="flex:1; height:1px; background:var(--line2); align-self:center;"></span>
          </div>
          <p style="margin:0 0 26px 34px; font-size:14px; color:var(--t4);">{g.zh}</p>
          <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(330px,100%),1fr)); gap:16px;">
            {g.items.map(it => (
              <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener noreferrer' : undefined} style="display:flex; flex-direction:column; background:var(--card); border:1px solid var(--line); border-radius:16px; padding:22px 22px 18px; transition:all .18s;">
                <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px;">
                  <h3 style="margin:0; font-size:16.5px; font-weight:700; line-height:1.4; letter-spacing:-0.01em;">{it.title}</h3>
                  <span style="font-family:'Archivo',sans-serif; font-size:16px; color:var(--t6); flex-shrink:0;">{it.external ? '↗' : '→'}</span>
                </div>
                <p style="margin:10px 0 0; font-size:13.5px; line-height:1.75; color:var(--t3); text-wrap:pretty;">{it.description}</p>
